      }
    },
    "Unlock the session to view enrolled identities." : {
      "shouldTranslate" : false
    },
    "Up" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba"
          }
        }
      }
    },
    "Update" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar"
          }
        }
      }
    },
    "Use it" : {
      "shouldTranslate" : false
    },
    "Used for Face enrollment and for unlocking your Mac" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para registrar tu rostro y para desbloquear tu Mac"
          }
        }
      }
    },
    "Used to tell enrolled faces apart when more than one person is set up on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve para distinguir los rostros registrados cuando hay más de una persona configurada en esta Mac."
          }
        }
      }
    },
    "Using %@ for the %@ profile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa %@ para el perfil %@."
          }
        }
      }
    },
    "Verify my face after other unlock methods" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificar mi rostro tras otros métodos de desbloqueo"
          }
        }
      }
    },
    "Version %@ (%@)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión %@ (%@)"
          }
        }
      }
    },
    "Vision did not produce a feature print for this image." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vision no generó una huella de características para esta imagen."
          }
        }
      }
    },
    "When sudo needs a password, Facekey asks you to accept and checks your face. With this off for the current display setup, sudo asks for your password as usual." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando sudo pide una contraseña, Facekey te pide aceptar y verifica tu rostro. Si está desactivado para la configuración de pantallas actual, sudo pide tu contraseña como siempre."
          }
        }
      }
    },
    "Without it Facekey recognizes you but can't unlock. If it was granted before, remove and re-add Facekey in System Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin él, Facekey te reconoce pero no puede desbloquear. Si se concedió antes, quita y vuelve a agregar Facekey en Ajustes del Sistema."
          }
        }
      }
    },
    "Yaw: %@  Pitch: %@" : {
      "shouldTranslate" : false
    },
    "You're all set" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo listo"
          }
        }
      }
    },
    "Your enrolled faces couldn't be read, so nothing was saved — writing now would overwrite them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer tus rostros registrados, así que no se guardó nada: escribir ahora los sobrescribiría."
          }
        }
      }
    },
    "Your password is required to unlock your Mac. It is encrypted and securely stored on your device. Facekey works entirely offline, so your password never leaves your Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita tu contraseña para desbloquear tu Mac. Se cifra y se guarda de forma segura en tu dispositivo. Facekey funciona totalmente sin conexión, así que tu contraseña nunca sale de tu Mac."
          }
        }
      }
    },
    "“On space” reads the keyboard directly to see the space key on the lock screen, which needs Accessibility — the same permission Facekey uses to type your password. Switch Facekey on under Privacy & Security → Accessibility, then quit and reopen Facekey." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Al presionar espacio” lee el teclado directamente para detectar la barra espaciadora en la pantalla de bloqueo, lo cual requiere Accesibilidad, el mismo permiso que Facekey usa para escribir tu contraseña. Activa Facekey en Privacidad y seguridad → Accesibilidad y luego cierra y vuelve a abrir Facekey."
          }
        }
      }
    },
    "Default distance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal"
          }
        }
      }
    }
  },
  "version" : "1.1"
}
