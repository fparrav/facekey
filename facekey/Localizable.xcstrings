        }
      }
    },
    "Unlock the session to see the app list and the history." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea la sesión para ver la lista de apps y el historial."
          }
